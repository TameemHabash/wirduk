{
  "name": "wirduk",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "content:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/build-content-db.ts",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/build-content-db.ts --check",
    "branding:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/branding/build-branding.ts",
    "dorar:receiver": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dorar/receiver.ts",
    "dorar:apply": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dorar/apply-page.ts",
    "db:peek": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev/peek-db.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "verify": "npm run typecheck && npm run lint && npm run content:check && jest --ci"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.6",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.3",
    "react-i18next": "^17.0.18",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "react-dom": "19.2.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
